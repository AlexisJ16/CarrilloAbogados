# =============================================================================
# Carrillo Abogados - Environment Variables Template
# =============================================================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control
# =============================================================================

# -----------------------------------------------------------------------------
# n8n Cloud Integration
# -----------------------------------------------------------------------------
N8N_API_KEY=your-n8n-api-key-here
N8N_API_URL=https://carrilloabgd.app.n8n.cloud

# -----------------------------------------------------------------------------
# Google Cloud Platform (Future)
# -----------------------------------------------------------------------------
# GOOGLE_CLIENT_ID=your-google-client-id
# GOOGLE_CLIENT_SECRET=your-google-client-secret
# GOOGLE_CALENDAR_API_KEY=your-calendar-api-key
# GOOGLE_GMAIL_API_KEY=your-gmail-api-key

# -----------------------------------------------------------------------------
# Database (Local Development)
# NOTE: For Docker Compose use POSTGRES_HOST=postgresql, NATS_SERVER=nats://nats:4222
# For local IDE use POSTGRES_HOST=localhost, NATS_SERVER=nats://localhost:4222
# -----------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=carrillo
POSTGRES_PASSWORD=your-postgres-password-here
POSTGRES_DB=carrillo_legal_tech

# Docker image tag (dev, staging, latest)
DOCKER_IMAGE_TAG=dev

# JWT Secret (min 64 chars recommended)
JWT_SECRET=your-jwt-secret-key-here-min-64-characters-recommended

# -----------------------------------------------------------------------------
# NATS Messaging
# -----------------------------------------------------------------------------
NATS_ENABLED=true
NATS_SERVER=nats://localhost:4222

# -----------------------------------------------------------------------------
# Security Tokens (CI/CD - Use GitHub Secrets)
# -----------------------------------------------------------------------------
# SNYK_TOKEN=your-snyk-token
# SONAR_TOKEN=your-sonar-token
