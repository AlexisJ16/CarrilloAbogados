    {
      "id": "error-handler",
      "name": "Error Handler",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1200, 520],
      "parameters": {
        "language": "javaScript",
        "mode": "runOnceForAllItems",
        "jsCode": "// Get error from AI Agent node\nconst error = $input.first().json.error || $input.first().json;\n\n// Try to get keyword data from Set Variables node\nlet keywordData = {};\ntry {\n  keywordData = $('Set Variables').first().json || {};\n} catch (e) {\n  keywordData = {\n    keyword_id: 'unknown',\n    keyword_text: 'unknown'\n  };\n}\n\nreturn [{\n  json: {\n    timestamp: new Date().toISOString(),\n    keyword_id: keywordData.keyword_id || 'unknown',\n    keyword_text: keywordData.keyword_text || 'unknown',\n    error_type: error.name || 'UnknownError',\n    error_message: error.message || JSON.stringify(error),\n    error_stack: error.stack || '',\n    workflow_execution_id: $execution.id,\n    resolution_status: 'pending'\n  }\n}];"
      }
    },
